  "leakage_rules": {
    "rule_1_no_signature_tokens": "Question must NOT contain governing section's signature tokens (e.g. 'Open Group Case Credits','Recognized Manager','Personal and Non-Manager Case Credits','Leadership Bonus Qualified').",
    "rule_2_token_overlap_gate": "Reject if content-token overlap with governing section title/body > 30%.",
    "rule_3_intent_first": "Author from how a real FBO/customer asks (vague, plain-language, non-native), then label.",
    "rule_4_no_answer_text": "Never include the answer value (numbers, thresholds, phone numbers) in the question."
  },
  "scoring_defaults": {
    "primary_metric": "Recall@1_governing",
    "secondary_metrics": [
      "Recall@5_anyrelevant",
      "Recall@10_anyrelevant",
      "MRR"
    ],
    "separate_layers": [
      "candidate_recall",
      "selector_success",
      "answer_delivered"
    ],
    "locale_isolation_check": "For every locale_policy case, a retrieval from the WRONG market's policy counts as a miss even if the section number matches. This is the primary reason for multi-market distribution.",
    "note": "Report candidate recall independently from selector/confidence-gate outcomes."
  },
